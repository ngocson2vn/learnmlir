{
    "configurations": [
        {
            "name": "Linux",
            "defines": [
                "GOOGLE_CUDA",
                "GET_OP_CLASSES",
                "GEN_PASS_REGISTRATION"
            ],
            "includePath": [
                "/usr/local/cuda-12.4/include",
                "${workspaceFolder}/examples/lower_mhlo_broadcast",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/llvm-build/include",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/llvm-build/tools/mlir/include",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/third_party/llvm-project/mlir/include",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/third_party/llvm-project/llvm/include",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/third_party/mlir-hlo",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/third_party/mlir-hlo/stablehlo",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/build/third_party/mlir-hlo",
                "${workspaceFolder}/examples/lower_mhlo_broadcast/build/third_party/mlir-hlo/stablehlo"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "browse": {
                "databaseFilename": "${workspaceFolder}/.vscode/vc.db",
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ],
    "version": 4
}
